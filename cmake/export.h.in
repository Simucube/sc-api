/**
 * @file
 * @brief Visibility macro for symbols that need an explicit import declaration.
 *
 * This header is generated by CMake when sc-api is built and records how the
 * library was built. Consumers do not have to define anything themselves.
 *
 * Function and class symbols of a shared build are exported automatically by
 * the build system. Constant global data (the sim_data property references) is
 * not, because the automatic export skips read-only sections. Such data needs
 * the SC_API_EXPORT annotation.
 */

#ifndef SC_API_EXPORT_H_
#define SC_API_EXPORT_H_

/** 1 if this sc-api build is a shared library (DLL), 0 if it is a static library. */
#cmakedefine01 SC_API_BUILT_SHARED

#if SC_API_BUILT_SHARED && defined(_WIN32)
#if defined(SC_API_BUILDING)
#define SC_API_EXPORT __declspec(dllexport)
#else
#define SC_API_EXPORT __declspec(dllimport)
#endif
#else
#define SC_API_EXPORT
#endif

#endif  // SC_API_EXPORT_H_
